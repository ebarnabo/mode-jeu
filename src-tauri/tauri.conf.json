{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode Jeu",
  "version": "0.3.0",
  "identifier": "com.pdcdesign.modejeu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mode Jeu",
        "width": 920,
        "height": 760,
        "minWidth": 760,
        "minHeight": 640,
        "decorations": true,
        "skipTaskbar": false,
        "theme": "Dark",
        "backgroundColor": "#0E0F12"
      },
      {
        "label": "overlay",
        "title": "Mode Jeu Overlay",
        "url": "index.html?window=overlay",
        "width": 220,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENEQ2N0IyQzk1NkNBNEUKUldST3lsYkpzbWROM2IrMVJMRklKMnJGa1hyR1ZjSlZia2oydXRTakZrcFY5WFVLY0dESDhKUnkK",
      "endpoints": [
        "https://github.com/ebarnabo/mode-jeu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
