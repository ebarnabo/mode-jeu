{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode Jeu",
  "version": "0.2.0",
  "identifier": "com.pdcdesign.modejeu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mode Jeu",
        "width": 880,
        "height": 720,
        "minWidth": 720,
        "minHeight": 600,
        "decorations": true,
        "skipTaskbar": false,
        "theme": "Dark",
        "backgroundColor": "#0E0F12"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENEQ2N0IyQzk1NkNBNEUKUldST3lsYkpzbWROM2IrMVJMRklKMnJGa1hyR1ZjSlZia2oydXRTakZrcFY5WFVLY0dESDhKUnkK",
      "endpoints": [
        "https://github.com/ebarnabo/mode-jeu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
