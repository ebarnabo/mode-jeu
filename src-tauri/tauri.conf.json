{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode Jeu",
  "version": "0.1.0",
  "identifier": "com.pdcdesign.modejeu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mode Jeu",
        "width": 880,
        "height": 720,
        "minWidth": 720,
        "minHeight": 600,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0E0F12"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
